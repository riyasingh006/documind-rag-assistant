# Copy this file to backend/.env and adjust as needed.
# All variables use the DOCUMIND_ prefix.

# --- Storage ---------------------------------------------------------------
# DOCUMIND_DATA_DIR=./data
DOCUMIND_MAX_UPLOAD_MB=20
DOCUMIND_MAX_PDF_PAGES=500

# --- Embeddings (local) ----------------------------------------------------
DOCUMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCUMIND_EMBEDDING_DEVICE=cpu
DOCUMIND_EMBEDDING_BATCH_SIZE=32

# --- Retrieval defaults ----------------------------------------------------
DOCUMIND_CHUNK_SIZE=800
DOCUMIND_CHUNK_OVERLAP=120
DOCUMIND_TOP_K=5
DOCUMIND_SCORE_THRESHOLD=0.2
DOCUMIND_MAX_CONTEXT_CHARS=12000
DOCUMIND_MAX_EXCERPT_CHARS=1600

# --- LLM provider ----------------------------------------------------------
# auto: Ollama if reachable, then external provider if configured,
#       then a labeled extractive fallback.
# ollama / openai / extractive force a specific mode.
DOCUMIND_LLM_PROVIDER=auto
DOCUMIND_LLM_TIMEOUT_SECONDS=240
DOCUMIND_LLM_TEMPERATURE=0.1
DOCUMIND_LLM_MAX_TOKENS=350
DOCUMIND_EXTRACTIVE_FALLBACK=true

# Local Ollama (recommended, no paid API required)
# DOCUMIND_* is the project convention. Bare OLLAMA_BASE_URL / OLLAMA_MODEL
# are also accepted for compatibility with standard Ollama tooling.
DOCUMIND_OLLAMA_BASE_URL=http://localhost:11434
DOCUMIND_OLLAMA_MODEL=qwen2.5:3b

# Optional OpenAI-compatible provider. Leave the key empty to disable.
DOCUMIND_OPENAI_BASE_URL=https://api.openai.com/v1
DOCUMIND_OPENAI_API_KEY=
DOCUMIND_OPENAI_MODEL=gpt-4o-mini

# --- CORS ------------------------------------------------------------------
DOCUMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional regex for origins that change per deploy (preview URLs), e.g.:
# DOCUMIND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# For a deployed frontend, add its exact origin (no path) to the list above,
# e.g. https://riyasingh006.github.io
