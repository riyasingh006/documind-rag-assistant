# Copy to backend/.env for local development. Never commit real keys.

# Google AI Studio key; use the backend/Render secret store, never a Vite variable.
DOCUMIND_GEMINI_API_KEY=

# Gemini embeddings and grounded answer generation.
DOCUMIND_EMBEDDING_MODEL=gemini-embedding-001
DOCUMIND_EMBEDDING_DIMENSION=768
DOCUMIND_EMBEDDING_BATCH_SIZE=32
DOCUMIND_EMBEDDING_TIMEOUT_SECONDS=20
DOCUMIND_EMBEDDING_RETRY_BUDGET_SECONDS=35
DOCUMIND_LLM_PROVIDER=gemini
DOCUMIND_LLM_MODEL=gemini-3.8-flash
DOCUMIND_LLM_TIMEOUT_SECONDS=20
DOCUMIND_LLM_RETRY_BUDGET_SECONDS=35
DOCUMIND_LLM_TEMPERATURE=0.1
DOCUMIND_LLM_MAX_TOKENS=350
DOCUMIND_EXTRACTIVE_FALLBACK=true

# Storage and retrieval.
# DOCUMIND_DATA_DIR=./data
DOCUMIND_MAX_UPLOAD_MB=20
DOCUMIND_MAX_PDF_PAGES=500
DOCUMIND_CHUNK_SIZE=800
DOCUMIND_CHUNK_OVERLAP=120
DOCUMIND_TOP_K=5
DOCUMIND_SCORE_THRESHOLD=0.2
DOCUMIND_MAX_CONTEXT_CHARS=12000
DOCUMIND_MAX_EXCERPT_CHARS=1600

# Allow the current Render frontend and local Vite dev/preview origins.
DOCUMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://documind-rag-assistant.onrender.com
